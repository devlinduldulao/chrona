{
    "name": "chrona-workspace",
    "private": true,
    "license": "MIT",
    "type": "module",
    "packageManager": "pnpm@12.3.4",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "pnpm --filter chrona-playground dev",
        "build": "pnpm --filter chrona-core build && pnpm --filter chrona-react build && pnpm --filter chrona-playground build",
        "test": "vitest run",
        "test:watch": "vitest",
        "coverage": "vitest run --coverage",
        "test:native": "node scripts/test-native.mjs",
        "test:e2e": "playwright test",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "check": "pnpm typecheck && pnpm lint && pnpm coverage && pnpm build && pnpm size && pnpm verify:package",
        "size": "size-limit",
        "changeset": "changeset",
        "verify:package": "node scripts/verify-package-exports.mjs"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.7",
        "@eslint/js": "^9.39.1",
        "@playwright/test": "^1.56.0",
        "@size-limit/preset-small-lib": "^11.2.0",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.19.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^5.1.0",
        "@vitest/coverage-v8": "3.2.7",
        "axe-core": "^4.11.0",
        "eslint": "^9.39.1",
        "eslint-plugin-react-hooks": "^5.2.0",
        "fast-check": "^4.3.0",
        "jsdom": "^26.1.0",
        "lucide-react": "^0.468.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "size-limit": "^11.2.0",
        "temporal-polyfill": "^0.3.0",
        "tsup": "^8.5.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.48.0",
        "vite": "^7.2.0",
        "vitest": "^3.2.4"
    },
    "size-limit": [
        {
            "name": "React Calendar",
            "path": "packages/react/dist/calendar.js",
            "limit": "6 kB",
            "gzip": true,
            "ignore": [
                "react",
                "react-dom"
            ]
        },
        {
            "name": "React DatePicker",
            "path": "packages/react/dist/date-picker.js",
            "limit": "12 kB",
            "gzip": true,
            "ignore": [
                "react",
                "react-dom"
            ]
        },
        {
            "name": "Core",
            "path": "packages/core/dist/index.js",
            "limit": "12 kB",
            "gzip": true
        }
    ]
}
